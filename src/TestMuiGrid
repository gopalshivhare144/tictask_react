import Grid from "@mui/material/Grid";
import Typography from "@mui/material/Typography";

export default function TestMuiGrid() {
  return (
   <Grid container spacing={3} sx={{ mt: 1 }}>
          {focuses.map((f) => (
            <Grid key={f.id} item xs={12} sm={6} md={4}>
              <FocusCard
                focus={f}
                icons={ICONS}
                onStart={handleStart}
                onPauseOrClear={handlePauseOrClear}
                onDelete={handleDelete}
                onEdit={(focus) => {
                  setModalOpen(true);
                  setEditFocus(focus);
                }}
                updateLastValue={(id, value) =>
                  setFocuses((list) =>
                    list.map((prof) =>
                      prof.id === id ? { ...prof, lastValue: value } : prof
                    )
                  )
                }
              />
            </Grid>
          ))}
        </Grid>
  );
}
